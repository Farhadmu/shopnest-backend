  "@types/cors": "^2.8.17",
  "@types/express": "^4.17.21",
  "@types/multer": "^1.4.12",
  "@types/node": "^22.10.5",
  "eslint": "^9.18.0",
  "tsx": "^4.19.2",
  "typescript": "5.7.3",
  "typescript-eslint": "^8.19.0",
