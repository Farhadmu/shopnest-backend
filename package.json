{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "ShopNest - AI-powered multi-vendor commerce backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "seed": "tsx src/seed.ts",
    "set-role": "tsx src/scripts/set-role.ts",
    "test": "vitest run"
  },
  "dependencies": {
